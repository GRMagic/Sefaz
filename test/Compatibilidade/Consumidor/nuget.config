<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="/pacotes" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- O rmdev.sefaz vem só do pacote gerado no container; todo o resto, do nuget.org -->
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="rmdev.sefaz" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
